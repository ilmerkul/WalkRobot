<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Физические константы -->
    <xacro:property name="mu1" value="0.8" />
    <xacro:property name="mu2" value="0.9" />

    <!-- Аргументы -->
    <xacro:arg name="namespace" default="/tropy_spot_0" />
    <xacro:arg name="entity_idx" default="0" />
    <xacro:arg name="exclude_gazebo_tags" default="false" />
    <xacro:arg name="exclude_ros2_control" default="false" />
</robot>