<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="leg_transmission" params="prefix">
        <transmission name="${prefix}_leg1_to_base_transmission">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}_leg1_to_base_joint">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
        <actuator name="${prefix}_leg1_to_base_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
        </transmission>

        <transmission name="${prefix}_leg2_to_leg1_transmission">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}_leg2_to_leg1_joint">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}_leg2_to_leg1_motor">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <transmission name="${prefix}_leg3_to_leg2_transmission">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}_leg3_to_leg2_joint">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
        <actuator name="${prefix}_leg3_to_leg2_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
        </transmission>
    </xacro:macro>

    <xacro:leg_transmission prefix="front_right"/>
    <xacro:leg_transmission prefix="back_right"/>
    <xacro:leg_transmission prefix="front_left"/>
    <xacro:leg_transmission prefix="back_left"/>
</robot>